{
  "name": "ff8",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "npm run generate-exits",
    "dev": "vite",
    "extract": "cargo run --release --manifest-path extractor/Cargo.toml",
    "generate-exits": "npx tsx scripts/generateExits.ts",
    "build": "tsc && npm run prepare && vite build",
    "deploy": "npm run build && netlify deploy --prod",
    "lint": "eslint ./src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "10.3.0",
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "howler": "^2.2.4",
    "joystick-controller": "^1.1.1",
    "postprocessing": "^6.37.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.177.0",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.0",
    "@react-three/eslint-plugin": "^0.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/howler": "^2.2.12",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.177.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react-swc": "3.10.2",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-canonical": "^5.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "prettier": "^3.8.3",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "7.0.0",
    "vite-plugin-image-optimizer": "2.0.1",
    "vite-plugin-pwa": "^1.0.2"
  }
}
